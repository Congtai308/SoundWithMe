# Copy to .env.local (web) / .env (api) as appropriate. Never commit the
# real filled-in version — only this .env.example is committed.

# ---- Shared ----
NODE_ENV=development

# ---- API (apps/api) ----
PORT=4000
WEB_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/soundwithme
REDIS_URL=redis://localhost:6379

# Auth — provider decision is still open (see Architecture Review §17 risk #3).
# Placeholder name kept generic until that decision is made.
JWT_SECRET=

# Object storage (Cloudflare R2 / S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Observability
SENTRY_DSN=
POSTHOG_KEY=

# ---- Web (apps/web) ----
# Public: safe to expose to the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. Enables YouTube search (YouTube Data API v3). Without it, tracks can
# still be added by pasting a YouTube link (resolved via oEmbed, no key needed).
YOUTUBE_API_KEY=
# Optional backup key(s), comma-separated — used when the main key runs out of daily quota
YOUTUBE_API_KEY_BACKUP=

# Karaoke voice. Browsers connect directly (WebRTC, STUN); when a network
# blocks that (mobile data, CGNAT, offices) voices automatically go through
# this API's own socket relay — no external service needed. A TURN server is
# optional: it keeps those voices peer-to-peer (lower latency, less load here).
# Cloudflare TURN — dash.cloudflare.com → Realtime → TURN Server → Create:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# …or a fixed list (e.g. your own coturn) as JSON RTCIceServer[]:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
